# ==========================================
# Configurações do Homelab (TV Box TX9)
# Copie este arquivo para .env na TV Box
# ==========================================

# Banco de Dados
DB_NAME=dafabidb
DB_USER=dafabi_user
DB_PASSWORD=troque_por_uma_senha_segura_123

# Porta exposta na máquina local para o Cloudflare Tunnel
FRONT_PORT=3000

# Origens permitidas para CORS (seus domínios públicos ou túneis)
APP_CORS_ALLOWED_ORIGIN=https://dafabi.flxcloud.dev

# Imagens Docker (se for usar Docker Hub ou GHCR, coloque seu usuário)
# Exemplo: seudockerhub/dafabi-backend:latest
BACKEND_IMAGE=dafabi-backend:homelab
FRONTEND_IMAGE=dafabi-frontend:homelab
