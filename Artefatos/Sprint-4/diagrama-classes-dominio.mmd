---
title: DaFabi Frangos — Visão geral do domínio operacional
---
classDiagram
    direction TB

    class Loja
    class Usuario
    class Perfil {
        <<enumeration>>
        ADMINISTRADORA
        OPERADOR_CAIXA
    }
    class Categoria
    class Produto
    class EstoqueProduto
    class Lote
    class MovimentacaoEstoque
    class Caixa
    class MovimentacaoCaixa
    class Venda
    class ItemVenda
    class Estorno
    class Fornecedor
    class Compra
    class ItemCompra
    class Despesa

    Loja "1" o-- "1..*" Usuario : equipe
    Usuario "0..*" --> "1" Perfil : perfil
    Loja "1" *-- "1..*" Categoria : catálogo
    Loja "1" *-- "1..*" Produto : vende
    Categoria "1" <-- "0..*" Produto : classifica
    Produto "1" *-- "1" EstoqueProduto : saldo atual
    Produto "1" *-- "0..*" Lote : controla validade
    Produto "1" <-- "0..*" MovimentacaoEstoque : movimenta
    Lote "0..1" <-- "0..*" MovimentacaoEstoque : lote consumido ou recebido
    Usuario "1" <-- "0..*" MovimentacaoEstoque : responsável

    Loja "1" *-- "0..*" Caixa : abre
    Usuario "1" <-- "0..*" Caixa : operador
    Caixa "1" *-- "0..*" MovimentacaoCaixa : registra
    Caixa "0..1" <-- "0..*" Venda : caixa do balcão
    Usuario "0..1" <-- "0..*" Venda : operador de venda presencial
    Venda "1" *-- "1..*" ItemVenda : contém
    Produto "1" <-- "0..*" ItemVenda : vendido
    Venda "1" -- "0..1" Estorno : pode ser estornada
    Usuario "1" <-- "0..*" Estorno : autorizou

    Loja "1" *-- "0..*" Fornecedor : mantém cadastro
    Fornecedor "1" <-- "0..*" Compra : fornece
    Compra "1" *-- "1..*" ItemCompra : contém
    Produto "1" <-- "0..*" ItemCompra : repõe
    Loja "1" *-- "0..*" Despesa : registra
    Usuario "1" <-- "0..*" Despesa : registrou
