@startuml
' Diagrama de Caso de Uso - DaFabi Frangos (escopo da Sprint 4, detalhado)
' Renderize em https://www.plantuml.com/plantuml ou pela extensão PlantUML do VS Code
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor White
  BorderColor #333333
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #333333
}

title Diagrama de Caso de Uso: DaFabi Frangos\nEscopo da Sprint 4 (detalhado)

actor "Operador de caixa" as OP
actor "Administradora" as ADM

' A Administradora herda tudo o que o Operador faz (inclusive autenticar)
OP <|-- ADM

rectangle "Sistema DaFabi Frangos" {

  ' ---------- Autenticação e sessão (#59, #60) ----------
  usecase "UC-01: Autenticar Usuário\n#59 · #60"               as UC01
  usecase "UC-01.1: Validar Credenciais e Perfil\n#59"         as UC011
  usecase "UC-01.2: Encerrar Sessão\n#60"                      as UC012

  ' ---------- Dashboard financeiro (#61, #62) ----------
  usecase "UC-02: Visualizar Dashboard\n#61 · #62\n--\npontos de extensão\nPE1: Filtros do dashboard" as UC02
  usecase "UC-02.1: Consultar Resumo Financeiro\n#61 · #62"    as UC021
  usecase "UC-02.2: Filtrar por Período\n#62"                  as UC022

  ' ---------- Estornos (#63, #64) ----------
  usecase "UC-17: Registrar Estorno\n#63 · #64"                as UC17
  usecase "UC-04: Consultar Histórico de Vendas\n#64"          as UC04
  usecase "UC-17.1: Informar Motivo do Estorno\n#63 · #64"     as UC171

  ' ---------- Usuários e perfis (#58) ----------
  usecase "UC-18: Gerenciar Usuários\n#58\n--\npontos de extensão\nPE1: Ações sobre usuário" as UC18
  usecase "UC-18.1: Cadastrar Usuário\n#58"                    as UC181
  usecase "UC-18.2: Editar Usuário e Perfil\n#58"              as UC182
  usecase "UC-18.3: Inativar Usuário\n#58"                     as UC183
}

' Associações
OP  --> UC01
OP  --> UC012
ADM --> UC02
ADM --> UC17
ADM --> UC18

' «include»: o caso base sempre executa o incluído
UC01 ..> UC011 : <<include>>
UC02 ..> UC021 : <<include>>
UC17 ..> UC04  : <<include>>
UC17 ..> UC171 : <<include>>

' «extend»: comportamento opcional no ponto de extensão PE1
UC022 ..> UC02 : <<extend>> (PE1)
UC181 ..> UC18 : <<extend>> (PE1)
UC182 ..> UC18 : <<extend>> (PE1)
UC183 ..> UC18 : <<extend>> (PE1)

@enduml
