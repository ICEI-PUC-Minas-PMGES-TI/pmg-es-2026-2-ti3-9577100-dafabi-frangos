classDiagram
    direction TB

    class ImportacaoRelatorio
    class VinculoMarketplace["Vínculo da loja com o marketplace"]
    class ResumoItemMarketplace {
        +dataReferencia
        +receitaReportada
        +quantidadeVendida
    }
    class ItemCatalogoMarketplace {
        +nomeItemExterno
    }
    class MapeamentoProdutoMarketplace {
