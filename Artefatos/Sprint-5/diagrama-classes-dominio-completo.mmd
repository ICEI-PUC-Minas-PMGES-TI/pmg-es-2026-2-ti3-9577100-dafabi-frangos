    Loja "1" o-- "1..*" Usuario : equipe
    Usuario "0..*" --> "1" Perfil : perfil
    Loja "1" *-- "1..*" Categoria : catálogo
    Loja "1" *-- "1..*" Produto : comercializa
    Categoria "1" <-- "0..*" Produto : classifica
    Produto "1" *-- "1" EstoqueProduto : saldo atual
    Produto "1" *-- "0..*" Lote : lotes perecíveis
    Produto "1" <-- "0..*" MovimentacaoEstoque : histórico
    Lote "0..1" <-- "0..*" MovimentacaoEstoque : lote relacionado
    Usuario "1" <-- "0..*" MovimentacaoEstoque : responsável

    Loja "1" *-- "0..*" Caixa : mantém sessões
    Usuario "1" <-- "0..*" Caixa : operador
    Caixa "1" *-- "0..*" MovimentacaoCaixa : registra
    Caixa "0..1" <-- "0..*" Venda : caixa presencial
    Usuario "0..1" <-- "0..*" Venda : operador presencial
    Venda "1" *-- "1..*" ItemVenda : contém
    Produto "1" <-- "0..*" ItemVenda : vendido
    Venda "1" -- "0..1" Estorno : pode receber
    Usuario "1" <-- "0..*" Estorno : autoriza
    Venda "0..1" --> "0..1" MovimentacaoCaixa : recebimento em dinheiro
    Estorno "0..1" --> "0..1" MovimentacaoCaixa : devolução em dinheiro

    Loja "1" *-- "0..*" Fornecedor : cadastra
    Loja "1" *-- "0..*" Compra : registra
    Usuario "1" <-- "0..*" Compra : responsável
    Fornecedor "1" <-- "0..*" Compra : fornece
    Compra "1" *-- "1..*" ItemCompra : contém
    Produto "1" <-- "0..*" ItemCompra : reposto
    ItemCompra "1" --> "0..1" Lote : cria lote perecível
    ItemCompra "1" --> "1..*" MovimentacaoEstoque : entrada ou reversão
    Compra "0..1" --> "0..1" MovimentacaoCaixa : pagamento em dinheiro
    Loja "1" *-- "0..*" Despesa : registra
    Usuario "1" <-- "0..*" Despesa : responsável
    Despesa "0..1" --> "0..1" MovimentacaoCaixa : pagamento em dinheiro

    Loja "1" *-- "0..*" VinculoMarketplace : canais configurados
    VinculoMarketplace "1" <-- "0..*" ImportacaoRelatorio : origem
    Usuario "1" <-- "0..*" ImportacaoRelatorio : enviou
    ImportacaoRelatorio "1" *-- "1..*" LinhaImportada : valida
    ImportacaoRelatorio "1" --> "0..*" PedidoMarketplace : importa pedidos
    ImportacaoRelatorio "1" --> "0..*" ResumoItemMarketplace : importa itens
    ImportacaoRelatorio "0..1" --> "0..*" RepasseMarketplace : importa repasses
    PedidoMarketplace "0..1" --> "0..1" Venda : normaliza em venda
    VinculoMarketplace "1" <-- "0..*" PedidoMarketplace : canal
    VinculoMarketplace "1" <-- "0..*" RepasseMarketplace : canal
    VinculoMarketplace "1" <-- "0..*" ItemCatalogoMarketplace : catálogo externo
    ItemCatalogoMarketplace "1" <-- "0..*" ResumoItemMarketplace : item externo
    ItemCatalogoMarketplace "1" *-- "0..*" MapeamentoProdutoMarketplace : componentes opcionais
    MapeamentoProdutoMarketplace "0..*" --> "1" Produto : produto ou insumo
    ResumoItemMarketplace "1" *-- "0..*" AplicacaoEstoqueMarketplace : aplicações
    Produto "1" <-- "0..*" AplicacaoEstoqueMarketplace : recebe movimento
    VinculoMarketplace "1" *-- "0..1" MarcoEstoqueMarketplace : marco inicial

    Produto ..> StatusProduto
    Loja ..> FormaPagamentoVenda
    Lote ..> StatusLote
    MovimentacaoEstoque ..> TipoMovimentacaoEstoque
    Usuario ..> Perfil
    Caixa ..> StatusCaixa
    MovimentacaoCaixa ..> DirecaoMovimentacao
    MovimentacaoCaixa ..> TipoMovimentacaoCaixa
    Venda ..> OrigemVenda
    Venda ..> FormaPagamentoVenda
    Venda ..> StatusVenda
    Compra ..> StatusCompra
    Compra ..> SituacaoPagamento
    Compra ..> FormaPagamentoSaida
    Despesa ..> FormaPagamentoSaida
    Despesa ..> StatusDespesa
    ImportacaoRelatorio ..> TipoRelatorio
    ImportacaoRelatorio ..> StatusImportacao
    VinculoMarketplace ..> ProvedorMarketplace
    AplicacaoEstoqueMarketplace ..> StatusAplicacaoEstoque
